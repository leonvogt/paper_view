{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "rubyLsp.formatter": "standard",
  "rubyLsp.linters": ["standard"],
  "rubyLsp.enabledFeatures": {
    "diagnostics": true
  },
  "search.exclude": {
    "**/builds": true,
    "**/public": true,
    "**/tmp": true,
    "**/.claude/worktrees": true
  }
}
