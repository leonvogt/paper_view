<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <% if paper_view_full_reload_required? %>
      <meta name="turbo-visit-control" content="reload">
    <% end %>
    <meta name="turbo-cache-control" content="no-preview">
    <meta name="robots" content="noindex, nofollow">

    <title>PaperView</title>
    <%= tag.link rel: "icon", href: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="10 0 100 100"><text y=".90em" font-size="90">📝</text></svg>' %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "paper_view/shared/styles" %>
    <%= paper_view_turbo_script_tag %>
  </head>

  <body>
    <%= render "paper_view/shared/theme" %>

    <header class="pv-header">
      <%= link_to root_path, class: "pv-header__brand" do %>
        PaperView
      <% end %>

      <nav class="pv-header__nav">
        <%= link_to "Versions", root_path, class: paper_view_nav_class(controller_name == "versions") %>
        <%= link_to "Stats", stats_path, class: paper_view_nav_class(controller_name == "stats") %>
      </nav>

      <div class="pv-header__right">
        <% if main_app.respond_to?(:root_path) %>
          <span class="pv-header__meta"><%= link_to "← Back to app", main_app.root_path, data: {turbo: false} %></span>
        <% end %>

        <button type="button" class="pv-header__theme" data-pv-theme-toggle title="Switch between light and dark">
          <span class="pv-theme__to-dark">☾ Dark</span>
          <span class="pv-theme__to-light">☀ Light</span>
        </button>
      </div>
    </header>

    <main class="pv-main pv-stack">
      <%= render "paper_view/shared/flash" %>
      <%= yield %>
    </main>

    <%= render "paper_view/shared/script" %>
  </body>
</html>
