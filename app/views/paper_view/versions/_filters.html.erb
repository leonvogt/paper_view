<%= form_with url: versions_path, method: :get, local: true, data: {turbo: false}, class: "pv-search" do %>
  <%= paper_view_hidden_filters(except: %i[item_type item_id event whodunnit]) %>

  <div class="pv-field pv-field--grow">
    <label for="pv-item-type">Item type</label>

    <input
      id="pv-item-type"
      type="text"
      name="item_type"
      value="<%= query.item_type %>"
      class="pv-input"
      list="pv-item-types"
      placeholder="Type to search…"
      autocomplete="off"
      <%= "autofocus" if autofocus %>
    >

    <datalist id="pv-item-types">
      <%= safe_join(item_types.map { |item_type| tag.option(nil, value: item_type) }) %>
    </datalist>
  </div>

  <div class="pv-field">
    <label for="pv-item-id">Item ID</label>

    <input
      id="pv-item-id"
      type="text"
      name="item_id"
      value="<%= query.item_id %>"
      class="pv-input"
      placeholder="any"
      autocomplete="off"
      inputmode="numeric"
    >
  </div>

  <div class="pv-field">
    <label for="pv-event">Event</label>

    <select id="pv-event" name="event" class="pv-input">
      <option value="">Any event</option>
      <%= options_for_select(PaperView::VersionQuery::EVENTS, query.event) %>
    </select>
  </div>

  <div class="pv-field pv-field--grow">
    <label for="pv-whodunnit">Whodunnit</label>

    <input
      id="pv-whodunnit"
      type="text"
      name="whodunnit"
      value="<%= query.whodunnit %>"
      class="pv-input"
      list="pv-whodunnits"
      placeholder="anyone"
      autocomplete="off"
    >

    <datalist id="pv-whodunnits">
      <%= safe_join(whodunnits.map { |whodunnit| tag.option(paper_view_whodunnit_label(whodunnit), value: whodunnit) }) %>
    </datalist>
  </div>

  <div class="pv-field pv-field--actions">
    <button type="submit" class="pv-btn pv-btn--primary">Search</button>
  </div>
<% end %>
