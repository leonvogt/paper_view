<div
  class="pv-version<%= " pv-version--selected" if selected %><%= " pv-version--multi-item-view" if multi_item_view %>"
  data-pv-version="<%= row.id %>"
  role="button"
  tabindex="0"
  aria-pressed="<%= selected %>"
>
  <div class="pv-version__time"><%= row.time %></div>

  <div class="pv-version__rail">
    <span class="pv-version__dot"></span>
    <span class="pv-version__line"></span>
  </div>

  <% if multi_item_view %>
    <div class="pv-version__item">
      <%= link_to row.item_label, paper_view_item_path(row.version), class: "pv-version__item-link" %>
      <span class="pv-pill pv-pill--<%= row.event %>"><%= row.event %></span>
    </div>
  <% end %>

  <div class="pv-version__content">
    <div class="pv-version__meta">
      <span class="pv-version__actor"><%= paper_view_whodunnit(row.version) %></span>

      <% unless multi_item_view %>
        <span class="pv-pill pv-pill--event"><%= row.event %></span>
      <% end %>

      <% if row.burst? %>
        <span class="pv-pill pv-pill--burst"><%= row.burst_label %></span>
      <% end %>
    </div>

    <% row.lines.each do |line| %>
      <div class="pv-change">
        <span class="pv-change__path"><%= line.path %></span>
        <span class="pv-value pv-value--old" title="<%= line.old_text %>"><%= truncate(line.old_text, length: 140) %></span>
        <span class="pv-change__arrow">→</span>
        <span class="pv-value pv-value--new" title="<%= line.new_text %>"><%= truncate(line.new_text, length: 140) %></span>
      </div>
    <% end %>

    <% row.footnotes.each do |note| %>
      <div class="pv-version__note"><%= note %></div>
    <% end %>
  </div>

  <div class="pv-version__id">#<%= row.id %></div>
</div>
