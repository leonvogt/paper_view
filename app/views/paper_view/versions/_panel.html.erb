<section
  class="pv-card pv-detail"
  data-pv-panel="<%= row.id %>"
  <%= "hidden" unless active %>
>
  <div class="pv-detail__head">
    <span class="pv-detail__id">Version #<%= row.id %></span>
    <span class="pv-detail__stamp"><%= paper_view_time(row.version.created_at) %></span>
  </div>

  <div class="pv-detail__meta<%= " pv-detail__meta--split" if multi_item_view %>">
    <% if multi_item_view %>
      <div class="pv-detail__field">
        <span class="pv-label">Item</span>
        <%= link_to row.item_label, paper_view_item_path(row.version), class: "pv-detail__item", title: row.item_label %>
      </div>
    <% end %>

    <div class="pv-detail__field">
      <span class="pv-label">Whodunnit</span>
      <span class="pv-detail__who"><%= paper_view_whodunnit(row.version) %></span>
    </div>
  </div>

  <% if row.metadata.any? %>
    <div class="pv-detail__metadata">
      <span class="pv-label">Metadata</span>

      <div class="pv-meta">
        <% row.metadata.visible.each do |entry| %>
          <span class="pv-meta__key"><%= entry.name %></span>
          <span class="pv-meta__value"><%= entry.text %></span>
        <% end %>
      </div>

      <% if row.metadata.hidden.any? %>
        <% rest_id = "pv-meta-#{row.id}" %>
        <button
          type="button"
          class="pv-meta__more"
          aria-expanded="false"
          aria-controls="<%= rest_id %>"
          data-pv-toggle="<%= rest_id %>"
        >
          <span class="pv-disclosure__arrow">▸</span>
          <%= row.metadata.hidden.size %> more
          <%= "key".pluralize(row.metadata.hidden.size) %>
        </button>

        <div class="pv-meta" id="<%= rest_id %>" hidden>
          <% row.metadata.hidden.each do |entry| %>
            <span class="pv-meta__key"><%= entry.name %></span>
            <span class="pv-meta__value"><%= entry.text %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="pv-detail__body">
    <% if row.change_set.unreadable? %>
      <p class="pv-detail__note">
        The <code>object_changes</code> payload is neither readable YAML nor
        JSON, so it cannot be diffed.
        <% unless row.created? %>
          The stored bytes are below under <strong>Raw object_changes</strong>.
        <% end %>
      </p>
    <% else %>
      <span class="pv-label"><%= row.change_label %></span>

      <% if row.change_set.empty? %>
        <p class="pv-detail__note">
          The <code>object_changes</code> column is empty for this event.
        </p>
      <% end %>

      <% row.change_set.each_with_index do |change, index| %>
        <div class="pv-attribute">
          <span class="pv-attribute__name"><%= change.name %></span>

          <% if row.created? %>
            <div class="pv-bars">
              <div class="pv-bar pv-bar--new"><%= change.new_text %></div>
            </div>
          <% elsif row.destroyed? %>
            <div class="pv-bars">
              <div class="pv-bar pv-bar--old"><%= change.old_text %></div>
            </div>
          <% elsif change.nested? %>
            <% change.leaf_changes.each do |leaf| %>
              <div class="pv-keys">
                <span class="pv-keys__name"><%= leaf.path %></span>

                <div class="pv-keys__values">
                  <span class="pv-value pv-value--old"><%= leaf.old_text %></span>
                  <span class="pv-change__arrow">→</span>
                  <span class="pv-value pv-value--new"><%= leaf.new_text %></span>
                </div>
              </div>
            <% end %>
            <% if change.unchanged_count.positive? %>
              <% whole_id = "pv-whole-#{row.id}-#{index}" %>
              <button
                type="button"
                class="pv-attribute__unchanged"
                aria-expanded="false"
                aria-controls="<%= whole_id %>"
                data-pv-toggle="<%= whole_id %>"
              >
                <span class="pv-disclosure__arrow">▸</span>
                <%= change.unchanged_count %> unchanged
                <%= "value".pluralize(change.unchanged_count) %>
              </button>

              <div class="pv-bars" id="<%= whole_id %>" hidden>
                <div class="pv-bar pv-bar--old"><%= change.old_text %></div>
                <div class="pv-bar pv-bar--new"><%= change.new_text %></div>
              </div>
            <% end %>
          <% else %>
            <div class="pv-bars">
              <div class="pv-bar pv-bar--old"><%= change.old_text %></div>
              <div class="pv-bar pv-bar--new"><%= change.new_text %></div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <% unless row.created? %>
      <div class="pv-disclosures">
        <button
          type="button"
          class="pv-disclosure"
          aria-expanded="false"
          aria-controls="pv-raw-<%= row.id %>"
          data-pv-toggle="pv-raw-<%= row.id %>"
        >
          <span class="pv-disclosure__arrow">▸</span> Raw object_changes
        </button>

        <button
          type="button"
          class="pv-disclosure pv-disclosure--end"
          aria-expanded="false"
          aria-controls="pv-reify-<%= row.id %>"
          data-pv-toggle="pv-reify-<%= row.id %>"
        >
          <span class="pv-disclosure__arrow">▸</span> Reify
        </button>

        <pre class="pv-raw" id="pv-raw-<%= row.id %>" hidden><%= row.change_set.raw_text %></pre>

        <div class="pv-snippet" id="pv-reify-<%= row.id %>" hidden>
          <div class="pv-snippet__head">
            <span class="pv-snippet__label">Rails console</span>

            <button
              type="button"
              class="pv-snippet__copy"
              data-pv-copy="pv-snippet-<%= row.id %>"
            >
              Copy
            </button>
          </div>

          <pre class="pv-snippet__code" id="pv-snippet-<%= row.id %>"><%= row.console_snippet %></pre>
        </div>
      </div>
    <% end %>
  </div>
</section>
