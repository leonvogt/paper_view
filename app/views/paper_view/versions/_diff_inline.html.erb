<% numbered = change.multiline? %>
<table class="pv-diff pv-diff--inline">
  <colgroup>
    <col class="pv-diff__col-gutter">
    <col class="pv-diff__col-gutter">
    <col>
  </colgroup>

  <tbody>
    <% change.rows.each do |row| %>
      <tr>
        <% if row.gap? %>
          <%= tag.td(row.text, class: "pv-diff__gap", colspan: 3) %>
        <% else %>
          <%= tag.td(numbered ? row.old_number : nil, class: "pv-diff__gutter") %>
          <%= tag.td(numbered ? row.new_number : nil, class: "pv-diff__gutter") %>
          <%= paper_view_diff_cell(row, sign: true) %>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
