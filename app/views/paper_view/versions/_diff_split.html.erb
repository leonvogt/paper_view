<% numbered = change.multiline? %>
<table class="pv-diff pv-diff--split">
  <colgroup>
    <col class="pv-diff__col-gutter">
    <col>
    <col class="pv-diff__col-gutter">
    <col>
  </colgroup>

  <tbody>
    <% change.paired_rows.each do |left, right| %>
      <tr>
        <% if left&.gap? %>
          <%= tag.td(left.text, class: "pv-diff__gap", colspan: 4) %>
        <% else %>
          <%= tag.td(numbered ? left&.old_number : nil, class: "pv-diff__gutter") %>
          <%= paper_view_diff_cell(left) %>
          <%= tag.td(numbered ? right&.new_number : nil, class: "pv-diff__gutter") %>
          <%= paper_view_diff_cell(right) %>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
