<% content_for :title, "Version ##{@version.id}" %>

<div class="pv-row">
  <%= link_to "← All versions", versions_path, class: "pv-btn" %>
  <%= link_to "All versions of #{paper_view_item_label(@version)}",
        versions_path(item_type: @version.item_type, item_id: @version.item_id), class: "pv-btn" %>
  <span class="pv-spacer"></span>
  <% if @previous_version %>
    <%= link_to "← Version ##{@previous_version.id}", version_path(@previous_version, diff: @diff_mode), class: "pv-btn" %>
  <% end %>
  <% if @next_version %>
    <%= link_to "Version ##{@next_version.id} →", version_path(@next_version, diff: @diff_mode), class: "pv-btn" %>
  <% end %>
</div>

<section class="pv-panel">
  <div class="pv-panel__head">
    <span class="pv-badge pv-badge--<%= @version.event %>"><%= @version.event %></span>
    <span><%= paper_view_item_label(@version) %></span>
    <span class="pv-muted pv-mono">version #<%= @version.id %></span>

    <span class="pv-spacer"></span>
    <% if PaperView::VersionReverter.available_for?(@version) %>
      <%= form_with url: revert_version_path(@version), method: :post, local: true,
            data: {turbo: false, "pv-confirm" => paper_view_revert_confirm(@version)} do %>
        <button type="submit" class="pv-btn pv-btn--danger"><%= paper_view_revert_label(@version) %></button>
      <% end %>
    <% elsif PaperView.config.revert_enabled %>
      <span class="pv-muted">Undoing <code>create</code> events is disabled.</span>
    <% end %>
  </div>

  <div class="pv-panel__body">
    <div class="pv-meta">
      <div>
        <div class="pv-meta__label">Item</div>
        <div class="pv-meta__value pv-mono"><%= paper_view_item_label(@version) %></div>
      </div>
      <div>
        <div class="pv-meta__label">Whodunnit</div>
        <div class="pv-meta__value"><%= paper_view_whodunnit(@version) %></div>
      </div>
      <div>
        <div class="pv-meta__label">Created at</div>
        <div class="pv-meta__value">
          <%= paper_view_time(@version.created_at) %>
          <span class="pv-muted">(<%= paper_view_relative_time(@version.created_at) %>)</span>
        </div>
      </div>
      <% if @version.respond_to?(:transaction_id) %>
        <div>
          <div class="pv-meta__label">Transaction</div>
          <div class="pv-meta__value pv-mono"><%= @version.transaction_id || "—" %></div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="pv-panel">
  <div class="pv-panel__head">
    <span><%= @change_set.size %> changed <%= "attribute".pluralize(@change_set.size) %></span>
    <span class="pv-spacer"></span>
    <span class="pv-toggle">
      <%= link_to "Side by side", version_path(@version, diff: "split"),
            class: ("pv-toggle--active" if @diff_mode == :split) %>
      <%= link_to "Inline", version_path(@version, diff: "inline"),
            class: ("pv-toggle--active" if @diff_mode == :inline) %>
    </span>
  </div>

  <% if @change_set.unreadable? %>
    <div class="pv-empty">
      This version carries a payload that PaperTrail could not deserialize.<br>
      Add the classes it contains to <span class="pv-mono">ActiveRecord.yaml_column_permitted_classes</span>
      (<span class="pv-mono">Time</span>, <span class="pv-mono">Date</span>, <span class="pv-mono">ActiveSupport::TimeWithZone</span>, … ).
    </div>
  <% elsif @change_set.empty? %>
    <p class="pv-empty">
      No attribute changes recorded for this version — the
      <span class="pv-mono">object_changes</span> column is empty for this event.
    </p>
  <% else %>
    <% @change_set.each do |change| %>
      <%= render "paper_view/versions/change", change: change, mode: @diff_mode %>
    <% end %>

    <details class="pv-raw">
      <summary>Raw object_changes</summary>
      <pre><%= paper_view_pretty_json(@change_set.to_filtered_hash) %></pre>
    </details>
  <% end %>
</section>
