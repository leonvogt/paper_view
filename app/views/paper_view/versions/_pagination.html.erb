<% if paginator.total_pages > 1 %>
  <nav class="pv-pagination">
    <% if paginator.previous_page %>
      <%= link_to "← Previous", versions_path(paper_view_filter_params("page" => paginator.previous_page)), class: "pv-btn" %>
    <% else %>
      <span class="pv-btn pv-btn--disabled">← Previous</span>
    <% end %>

    <% paginator.page_numbers.each do |number| %>
      <% if number == :gap %>
        <span class="pv-pagination__gap">…</span>
      <% elsif number == paginator.page %>
        <span class="pv-pagination__page pv-pagination__page--current"><%= number %></span>
      <% else %>
        <%= link_to number, versions_path(paper_view_filter_params("page" => number)), class: "pv-pagination__page" %>
      <% end %>
    <% end %>

    <span class="pv-spacer"></span>

    <% if paginator.next_page %>
      <%= link_to "Next →", versions_path(paper_view_filter_params("page" => paginator.next_page)), class: "pv-btn" %>
    <% else %>
      <span class="pv-btn pv-btn--disabled">Next →</span>
    <% end %>
  </nav>
<% end %>
